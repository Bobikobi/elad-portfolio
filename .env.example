# Public-safe example values only. Never commit real secrets.

# Chat API — Kimi (Moonshot) is the primary model. Server-side only: this key is read in
# the /api/chat route handler and never reaches the browser. There is deliberately no
# NEXT_PUBLIC_ variant. Without it the route falls back to GEMINI_API_KEY; without either
# the widget shows its "chat is switched off" state instead of failing silently.
KIMI_API_KEY=REPLACE_WITH_KIMI_KEY
# Optional overrides (defaults: https://api.moonshot.ai/v1 and kimi-k2-0905-preview)
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2-0905-preview

# Fallback chat model
GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY

# Anti-bot for the chat widget (Cloudflare Turnstile). OPTIONAL: with no site key the
# widget still works and the route's rate limits carry the abuse load. Set the pair or
# neither — a site key without a secret means the browser solves a challenge nobody checks.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET_KEY

# App config
NEXT_PUBLIC_SITE_URL=https://www.eladsaadon.dev

# Optional distributed rate limiting (recommended in production)
UPSTASH_REDIS_REST_URL=REPLACE_WITH_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_UPSTASH_REDIS_REST_TOKEN

# --- M1: lead capture -------------------------------------------------------------------
# Injected automatically by the Neon integration (Vercel Marketplace) into all three
# environments. Must be a database in eu-central-1: the privacy policy names Frankfurt and
# the functions are pinned to fra1 to sit beside it. Absent → the site still builds and the
# contact form falls back to CONTACT_ENDPOINT.
DATABASE_URL=REPLACE_WITH_NEON_CONNECTION_STRING

# Set on the PREVIEW target only: the connection string for the Neon `preview` branch.
# The integration points every environment at `main`, so without this a preview submission
# - or the retention harness, which backdates and deletes rows - writes into real leads.
DATABASE_URL_PREVIEW=REPLACE_WITH_NEON_PREVIEW_BRANCH_CONNECTION_STRING

# Authorises the daily retention cron (/api/cron/retention), which enforces the policy's
# 24-month deletion. Fail-closed: without it the route answers 503, never "allow".
#   openssl rand -hex 32
CRON_SECRET=REPLACE_WITH_CRON_SECRET

# Salt for the one-way IP hash used by rate limiting. Without it the hash is an unsalted
# SHA-256 of an IP address, which is brute-forceable and therefore not anonymisation.
#   openssl rand -hex 32
PAGEVIEW_SALT=REPLACE_WITH_RANDOM_SALT
